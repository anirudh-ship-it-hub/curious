# Which AI provider the interpretation pipeline uses. Swap freely — not locked in.
AI_PROVIDER=groq
# Optional: override the default model for whichever provider is active above.
# AI_MODEL=

GROQ_API_KEY=
DEEPSEEK_API_KEY=
ANTHROPIC_API_KEY=

# Supabase project credentials (Project Settings -> API).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role key — server-only, bypasses RLS. NEVER prefix with NEXT_PUBLIC_, never send to
# the client. Only used by scripts/seed-questions.ts to write source='seed' rows.
SUPABASE_SERVICE_ROLE_KEY=
